{
  "name": "sat-act-math-bootcamp-site",
  "version": "1.0.0",
  "description": "Landing page, lead capture, privacy pages and student login for a free SAT/ACT math class and paid bootcamp (Vercel + Postgres)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:views": "node scripts/build-views.js",
    "build": "node scripts/build-views.js",
    "test": "node scripts/build-views.js && node test/smoke.test.js",
    "test:precompiled": "VIEWS_PRECOMPILED=1 node test/smoke.test.js",
    "test:pg": "node test/smoke.test.js"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vercel/nft": "^1.11.0"
  }
}
