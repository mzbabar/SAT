<%- include('../partials/head', { noindex: true }) %>
<%- include('../partials/app-nav') %>
<div class="app">
  <div class="wrap" style="max-width:520px">
    <h1 style="font-size:1.8rem">Change password</h1>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/portal/account" class="card" data-once>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="current" style="margin-top:0">Current password</label>
      <input type="password" id="current" name="current" autocomplete="current-password" required>
      <label for="password">New password (10+ characters)</label>
      <input type="password" id="password" name="password" autocomplete="new-password" minlength="10" required>
      <label for="password2">Repeat new password</label>
      <input type="password" id="password2" name="password2" autocomplete="new-password" minlength="10" required>
      <button class="btn btn-primary" type="submit" style="margin-top:18px">Change password</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
