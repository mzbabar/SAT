<%- include('partials/head', { noindex: true }) %>
<div class="auth">
  <div class="card">
    <h1 style="font-size:1.7rem">Student login</h1>
    <p class="muted">For enrolled bootcamp students. Your login link was sent to you by your tutor.</p>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" data-once>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="username" required value="<%= email %>">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:20px">Log in</button>
    </form>
    <p class="small muted" style="margin-top:16px">Forgot your password or need a first-time login link? Email <a href="mailto:<%= biz.email %>"><%= biz.email %></a>.</p>
  </div>
</div>
<%- include('partials/foot') %>
