<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' | ' : '' %><%= biz.name %></title>
<% const desc = typeof description !== 'undefined' ? description : 'Free live one-hour SAT and ACT math class on Zoom with ' + biz.tutorName + '. Learn the question types that show up most and leave with a practice plan.'; %>
<meta name="description" content="<%= desc %>">
<meta property="og:title" content="<%= title ? title + ' | ' : '' %><%= biz.name %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= cfg.siteUrl %><%= path %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<link rel="canonical" href="<%= cfg.siteUrl %><%= path %>">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css?v=<%= cfg.assetVersion %>">
</head>
<body data-pixel="<%= pixelId %>"<% if (typeof trackLead !== 'undefined' && trackLead) { %> data-track="lead"<% } %>>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">&#8721;</span><span><%= biz.name %></span></a>
    <nav aria-label="Main">
      <a href="/#how">How it works</a>
      <a href="/enroll">Bootcamp</a>
      <a class="keep" href="/login">Student login</a>
      <a class="btn btn-accent btn-sm" href="/#register">Free class</a>
    </nav>
  </div>
</header>
<% if (flash) { %><div class="wrap" style="margin-top:16px"><div class="alert alert-<%= flash.type === 'ok' ? 'ok' : 'error' %>" role="status"><%= flash.message %></div></div><% } %>
<main id="main">
